# Copy to .env for local development. Never commit .env.

# Superuser connection, used only by `pnpm migrate` (creates roles and applies migrations).
DATABASE_ADMIN_URL=postgres://ledgerworks:ledgerworks@localhost:5432/ledgerworks

# Password of the ledgerline_app role (the only role the API connects as). Change outside local dev.
LEDGERLINE_APP_PASSWORD=ledgerline_app

# Connection used by the API (the RLS-bound application role). Defaults to the admin URL's
# database with the ledgerline_app role, so it can usually be left unset.
# DATABASE_URL=postgres://ledgerline_app:ledgerline_app@localhost:5432/ledgerworks

# How many months of usage_events partitions the API keeps ahead of the current month.
PARTITION_MONTHS_AHEAD=6

# /metrics is served on its OWN port and bind address, never on the public API port. The default
# (loopback) is safe. For the Docker observability profile Prometheus reaches the host through
# host.docker.internal, so bind 0.0.0.0 there ONLY on a development machine, and consider a token.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
# METRICS_TOKEN=
# Password of the read-only ledgerline_metrics role (queue statistics, pg_stat_statements). Dev default only.
# LEDGERLINE_METRICS_PASSWORD=ledgerline_metrics
# Tracing is off unless an OTLP/HTTP traces endpoint is set (the obs profile runs Jaeger there).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# If set, POST /v1/tenants requires this value in the x-admin-token header. Leave unset only locally.
TENANT_CREATION_TOKEN=
