    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency p50 by route",
      "description": "histogram_quantile over 1 m of request durations, per route pattern",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerline-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerline-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(ledgerline_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
