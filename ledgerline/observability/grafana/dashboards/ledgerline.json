          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerline-prometheus"
          },
          "expr": "sum(rate(ledgerline_http_request_duration_seconds_count{status=~\"5..\"}[1m])) / sum(rate(ledgerline_http_request_duration_seconds_count[1m]))",
          "legendFormat": "5xx share"
