      "type": "stat",
      "title": "Partitions created (since process start)",
      "description": "usage_events partitions created by the automatic maintenance, and maintenance runs by result",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerline-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
