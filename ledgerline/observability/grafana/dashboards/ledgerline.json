{
  "uid": "ledgerline-overview",
  "title": "Ledgerline overview",
  "tags": ["ledgerline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
