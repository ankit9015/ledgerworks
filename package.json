{
  "name": "ledgerworks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --fileParallelism=false",
    "demo": "node scripts/demo.mjs",
    "e2e": "playwright test -c e2e",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "migrate": "pnpm --filter @ledgerworks/ledgerline migrate",
    "seed": "pnpm --filter @ledgerworks/ledgerline seed",
    "seed:demo": "pnpm --filter @ledgerworks/ledgerline seed:demo",
    "test:shadow-full": "node scripts/test-shadow-full.mjs",
    "llm:smoke": "pnpm --filter @ledgerworks/core llm:smoke",
    "mcp:inspect": "pnpm --filter @ledgerworks/core mcp:inspect"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
